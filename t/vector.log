[{"word":"vector","phonetics":[{"audio":"https://api.dictionaryapi.dev/media/pronunciations/en/vector-au.mp3","sourceUrl":"https://commons.wikimedia.org/w/index.php?curid=75857719","license":{"name":"BY-SA 4.0","url":"https://creativecommons.org/licenses/by-sa/4.0"}},{"text":"/ˈvɛktə/","audio":""},{"text":"/ˈvɛktɚ/","audio":"https://api.dictionaryapi.dev/media/pronunciations/en/vector-us.mp3","sourceUrl":"https://commons.wikimedia.org/w/index.php?curid=811909","license":{"name":"BY-SA 3.0","url":"https://creativecommons.org/licenses/by-sa/3.0"}}],"meanings":[{"partOfSpeech":"noun","definitions":[{"definition":"A directed quantity, one with both magnitude and direction; the signed difference between two points.","synonyms":[],"antonyms":[]},{"definition":"An ordered tuple representing a directed quantity or the signed difference between two points.","synonyms":[],"antonyms":[]},{"definition":"Any member of a (generalized) vector space.","synonyms":[],"antonyms":[],"example":"The vectors in {\\mathbb Q}[X] are the single-variable polynomials with rational coefficients: one is \\textstyle x^{42}+\\frac1{137}x-1."},{"definition":"A chosen course or direction for motion, as of an aircraft.","synonyms":[],"antonyms":[]},{"definition":"A carrier of a disease-causing agent.","synonyms":[],"antonyms":[]},{"definition":"(by extension) A person or entity that passes along an urban legend or other meme.","synonyms":[],"antonyms":[]},{"definition":"A recurring psychosocial issue that stimulates growth and development in the personality.","synonyms":[],"antonyms":[]},{"definition":"The way in which the eyes are drawn across the visual text. The trail that a book cover can encourage the eyes to follow from certain objects to others.","synonyms":[],"antonyms":[]},{"definition":"(operating systems) A memory address containing the address of a code entry point, usually one which is part of a table and often one that is dereferenced and jumped to during the execution of an interrupt.","synonyms":[],"antonyms":[]},{"definition":"A one-dimensional array.","synonyms":[],"antonyms":[]},{"definition":"A graphical representation using outlines; vector graphics.","synonyms":[],"antonyms":[],"example":"a vector image"},{"definition":"A DNA molecule used to carry genetic information from one organism into another.","synonyms":[],"antonyms":[]}],"synonyms":[],"antonyms":[]},{"partOfSpeech":"verb","definitions":[{"definition":"To set (particularly an aircraft) on a course toward a selected point.","synonyms":[],"antonyms":[]},{"definition":"To redirect to a vector, or code entry point.","synonyms":[],"antonyms":[]}],"synonyms":[],"antonyms":[]}],"license":{"name":"CC BY-SA 3.0","url":"https://creativecommons.org/licenses/by-sa/3.0"},"sourceUrls":["https://en.wiktionary.org/wiki/vector"]}]